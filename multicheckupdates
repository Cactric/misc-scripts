#!/usr/bin/bash

checkupdates
yay -Qua

masked="$(flatpak mask | sed 's/ //g')"
flatpak remote-ls --updates --columns=application,branch | grep -v -e "$masked"

LEGENDARY_CONFIG_PATH=~/.config/heroic/legendaryConfig/legendary/ /opt/Heroic/resources/app.asar.unpacked/build/bin/x64/linux/legendary list-installed --check-updates 2>/dev/null | grep -B 1 'Update available!'

# Only run get-updates if refreshing fwupd's metadata was either successful, or is already up-to-date
fwupdmgr refresh 2>/dev/null; refreshed=$?
if [ $refreshed -eq 0 ] || [ $refreshed -eq 2 ]; then
    fwupdmgr get-updates --json | jq -r '.Devices | map(.Name)[]'
fi
